{
  "name": "stockbook",
  "version": "1.8.0",
  "description": "나만의 주식 포트폴리오 관리 앱",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-syntax.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:setup": "npm i --no-save --ignore-scripts playwright@1.56.0 && npx playwright install --with-deps chromium",
    "test": "npm run check && npm run smoke",
    "build": "electron-builder --win nsis",
    "dist": "electron-builder --win nsis --publish never -c.directories.output=dist",
    "release:bump": "node scripts/bump-version.mjs"
  },
  "build": {
    "appId": "com.mj.stockbook",
    "productName": "Stock Book",
    "electronVersion": "31.7.7",
    "asar": false,
    "directories": {
      "output": "C:\\Temp\\StockBookBuild"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "splash.html",
      "manifest.json",
      "sw.js",
      "icon-192.png",
      "icon-512.png",
      "icon.ico",
      "logo.svg"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "language": "1042",
      "perMachine": false,
      "shortcutName": "Stock Book",
      "menuCategory": "Stock Book",
      "include": "installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "ws": "^8.21.1"
  }
}
